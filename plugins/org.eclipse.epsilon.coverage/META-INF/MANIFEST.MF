Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: org.eclipse.epsilon.coverage;singleton:=true
Automatic-Module-Name: org.eclipse.epsilon.coverage
Bundle-Version: 2.10.0.qualifier
Bundle-ClassPath: .
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: JavaSE-1.8
Export-Package: org.eclipse.epsilon.coverage,
 org.eclipse.epsilon.coverage.model,
 org.eclipse.epsilon.coverage.model.impl,
 org.eclipse.epsilon.coverage.model.util
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.emf.ecore;visibility:=reexport,
 org.eclipse.emf.ecore.xmi;visibility:=reexport,
 org.eclipse.epsilon.eol.engine;visibility:=reexport
Bundle-ActivationPolicy: lazy
