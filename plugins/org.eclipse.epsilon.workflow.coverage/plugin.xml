<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.ant.core.extraClasspathEntries">
      <extraClasspathEntry
            library="lib/org.eclipse.epsilon.workflow.coverage.jar">
      </extraClasspathEntry>
   </extension>
      <extension
         point="org.eclipse.ant.core.antTasks">
      <antTask
            class="org.eclipse.epsilon.workflow.tasks.coverage.CoverageStartTask"
            library="lib/org.eclipse.epsilon.workflow.coverage.jar"
            name="epsilon.coverage.start">
      </antTask>
      <antTask
            class="org.eclipse.epsilon.workflow.tasks.coverage.CoverageStopTask"
            library="lib/org.eclipse.epsilon.workflow.coverage.jar"
            name="epsilon.coverage.stop">
      </antTask>
   </extension>
</plugin>
